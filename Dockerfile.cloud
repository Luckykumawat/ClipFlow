FROM python:3.12-slim
ARG CLOUD_LITE=1
ENV CLOUD_LITE=${CLOUD_LITE} OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates nodejs && rm -rf /var/lib/apt/lists/*
COPY requirements-ai.txt /tmp/requirements-ai.txt
ARG CLOUD_YTDLP_VERSION=2026.11.17.232707.dev0
RUN pip install --no-cache-dir "yt-dlp[default,curl-cffi,deno]==${CLOUD_YTDLP_VERSION}" -r /tmp/requirements-ai.txt
ENV CLIPFLOW_YOUTUBE_BUILD=${CLOUD_YTDLP_VERSION}
ENV CLIPFLOW_SHARED_MAC_DIGEST=c04580c11d7b72768bd08f7c6636cfeba742600227dbcfa7c59061f9d780b3f4
RUN useradd --create-home --uid 10001 clipflow
WORKDIR /app
COPY --chown=clipflow:clipflow server.py storage.py /app/
COPY --chown=clipflow:clipflow assets /app/assets
COPY --chown=clipflow:clipflow web /app/web
RUN mkdir /app/models && chown clipflow:clipflow /app/models
RUN mkdir /data && chown clipflow:clipflow /data
USER clipflow
ENV BIND_HOST=0.0.0.0 DATA_DIR=/data
EXPOSE 8765
CMD ["python", "server.py"]
